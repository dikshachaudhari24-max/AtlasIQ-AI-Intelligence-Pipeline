APP_NAME=AtlasIQ
APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql://atlasiq_user:CHANGE_ME@localhost:5432/atlasiq

# Used only by optional Docker Compose. Set POSTGRES_PASSWORD in your local .env.
POSTGRES_USER=atlasiq_user
POSTGRES_DB=atlasiq
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

GEMINI_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
LLM_PROVIDER_ORDER=gemini,groq,deepseek
LLM_GEMINI_MODEL=gemini-flash-latest
LLM_GROQ_MODEL=openai/gpt-oss-120b
LLM_DEEPSEEK_MODEL=deepseek-flash
LLM_WORKERS=3
LLM_REQUESTS_PER_MINUTE=15
LLM_TIMEOUT_SECONDS=35
LLM_PROVIDER_ATTEMPTS=2
LLM_MAX_RETRY_WAIT_SECONDS=15
LLM_CHUNK_BYTES=5000
LLM_MAX_CHUNKS=24
LLM_REQUEST_BYTES=30000
LLM_INPUT_TOKEN_BUDGET=12000
LLM_OUTPUT_TOKENS=2048
LLM_ATTEMPT_BUDGET=96
GITHUB_TOKEN=
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_APPLICATION_CREDENTIALS=

CRAWLER_MAX_CONCURRENCY=10
CRAWLER_REQUEST_TIMEOUT_SECONDS=30
CRAWLER_HTTP_ATTEMPTS=3
CRAWLER_MAX_RETRY_WAIT_SECONDS=30
CRAWLER_MAX_RESPONSE_BYTES=4194304
CRAWLER_WORKER_CONCURRENCY=4
CRAWLER_USER_AGENT="AtlasIQ/0.2 (public-source ingestion)"
TASK_LEASE_SECONDS=120
TASK_MAX_ATTEMPTS=5
TASK_RETRY_BASE_SECONDS=5
TASK_RETRY_MAX_SECONDS=300
